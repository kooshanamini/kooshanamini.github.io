---
import { ME, type Publication } from '../data/publications';
import CitationBadge from './CitationBadge.astro';
import LinkPill from './LinkPill.astro';

interface Props {
	pub: Publication;
	/** Google Scholar citation count to show, if any. */
	citations?: number;
	headingLevel?: 'h3' | 'h4';
}

const { pub, citations, headingLevel: Heading = 'h3' } = Astro.props;

// Long author lists show the first six names.
const shown = pub.authors.length > 8 ? pub.authors.slice(0, 6) : pub.authors;
const hidden = pub.authors.length - shown.length;
const doiHref = pub.doi ? `https://doi.org/${pub.doi}` : undefined;
const titleHref = doiHref ?? pub.links?.[0]?.href;
---

<article>
	<Heading class="text-[1.0625rem] font-semibold leading-snug text-fg">
		{titleHref ? <a href={titleHref} class="transition-colors hover:text-accent">{pub.title}</a> : pub.title}
	</Heading>
	<p class="mt-1.5 text-sm leading-relaxed text-muted">
		{
			shown.map((author, i) => (
				<>
					{i > 0 && ', '}
					<span class:list={[author.replace('*', '') === ME && 'font-semibold text-fg']}>{author}</span>
				</>
			))
		}
		{hidden > 0 && <span>, and {hidden} more</span>}
		{pub.etAl && <span>, et al.</span>}
	</p>
	<p class="mt-1 text-sm leading-relaxed text-muted">
		<span class="italic">{pub.venue}</span>{pub.details && <span>, {pub.details}</span>}<span>, {pub.year}</span>
		{pub.note && <span class="text-subtle"> · {pub.note}</span>}
	</p>
	{
		pub.status && (
			<p class="mt-2.5">
				<span class="chip">{pub.status}</span>
			</p>
		)
	}
	<div class="mt-3 flex flex-wrap items-center gap-2">
		{doiHref && pub.type !== 'preprint' && <LinkPill href={doiHref} label="Paper" kind="paper" />}
		{pub.links?.map((link) => <LinkPill {...link} />)}
		{pub.project && <LinkPill href={`/projects/${pub.project}/`} label="Project page" kind="project" />}
		{citations !== undefined && <CitationBadge count={citations} />}
	</div>
</article>
