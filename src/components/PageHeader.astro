---
interface Props {
	title: string;
	lead?: string;
}

const { title, lead } = Astro.props;
---

<header class="container-site pb-14 pt-16 sm:pb-16 sm:pt-24">
	<h1 class="max-w-4xl text-[clamp(2.75rem,6.5vw,5rem)] font-normal leading-[1] tracking-[-0.03em]">{title}</h1>
	{lead && <p class="mt-7 max-w-[40rem] text-[1.1875rem] leading-relaxed">{lead}</p>}
	<slot />
</header>
