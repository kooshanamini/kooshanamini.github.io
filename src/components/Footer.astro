---
import { site } from '../data/site';
import EmailLink from './EmailLink.astro';

const year = new Date().getFullYear();
---

<footer class="border-t border-line">
	<div class="container-site grid gap-10 py-14 md:grid-cols-[minmax(0,1fr)_auto]">
		<div class="max-w-sm">
			<a href="/" class="font-display text-2xl font-medium text-fg">{site.name}</a>
			<p class="mt-3 leading-relaxed text-muted">
				{site.role}, {site.affiliation}. Machine learning for aerial and satellite imagery, and the risk models that
				turn it into decisions.
			</p>
		</div>

		<nav aria-label="Footer" class="grid grid-cols-2 gap-x-16 gap-y-2 text-[0.9375rem]">
			<ul class="space-y-2.5">
				<li><a href="/" class="hover:text-accent">About</a></li>
				{
					site.nav.map((item) => (
						<li>
							<a href={item.href} class="hover:text-accent">
								{item.label}
							</a>
						</li>
					))
				}
			</ul>
			<ul class="space-y-2.5">
				<li><EmailLink variant="plain" label="Email" class="hover:text-accent" /></li>
				{
					site.social.map((item) => (
						<li>
							<a href={item.href} class="hover:text-accent">
								{item.label}
							</a>
						</li>
					))
				}
				<li><a href={site.cv.href} class="hover:text-accent">CV (PDF)</a></li>
			</ul>
		</nav>
	</div>

	<div class="container-site flex flex-wrap gap-x-6 gap-y-1 pb-10 text-sm text-muted">
		<p>© {year} {site.name}</p>
		<a href="/privacy/" class="hover:text-fg">Privacy</a>
	</div>
</footer>
