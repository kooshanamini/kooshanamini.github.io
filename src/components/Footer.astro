---
import { site } from '../data/site';
import EmailLink from './EmailLink.astro';
import Icon from './Icon.astro';

const now = new Date();
const updated = new Intl.DateTimeFormat('en-US', { month: 'long', year: 'numeric' }).format(now);
---

<footer class="mt-24 border-t border-line">
	<div class="container-site grid gap-10 py-12 md:grid-cols-[minmax(0,1fr)_auto]">
		<div class="max-w-sm">
			<a href="/" class="font-semibold tracking-tight text-fg">{site.name}</a>
			<p class="mt-2 text-sm leading-relaxed text-muted">
				{site.role}, {site.affiliation}. Machine learning, computer vision, and remote sensing.
			</p>
			<div class="mt-5 flex items-center gap-1">
				<EmailLink variant="icon" />
				{
					site.social.map((item) => (
						<a
							href={item.href}
							class="grid size-9 place-items-center rounded-lg text-muted transition-colors hover:bg-surface hover:text-fg"
							aria-label={item.label}
						>
							<Icon name={item.icon} class="size-[18px]" />
						</a>
					))
				}
			</div>
		</div>

		<nav aria-label="Footer" class="grid grid-cols-2 gap-x-16 gap-y-2 text-sm">
			<div>
				<p class="font-medium text-fg">Site</p>
				<ul class="mt-3 space-y-2 text-muted">
					<li><a href="/" class="transition-colors hover:text-fg">About</a></li>
					{
						site.nav.map((item) => (
							<li>
								<a href={item.href} class="transition-colors hover:text-fg">
									{item.label}
								</a>
							</li>
						))
					}
				</ul>
			</div>
			<div>
				<p class="font-medium text-fg">Connect</p>
				<ul class="mt-3 space-y-2 text-muted">
					<li><EmailLink variant="plain" label="Email" /></li>
					{
						site.social.map((item) => (
							<li>
								<a href={item.href} class="transition-colors hover:text-fg">
									{item.label}
								</a>
							</li>
						))
					}
					<li><a href={site.cv.href} class="transition-colors hover:text-fg">CV (PDF)</a></li>
				</ul>
			</div>
		</nav>
	</div>

	<div class="border-t border-line">
		<div
			class="container-site flex flex-col gap-1.5 py-6 text-xs text-subtle sm:flex-row sm:items-center sm:justify-between"
		>
			<p>© {now.getFullYear()} {site.name} · <a href="/privacy/" class="transition-colors hover:text-fg">Privacy</a></p>
			<p>Updated {updated} · Built with Astro, hosted on GitHub Pages</p>
		</div>
	</div>
</footer>
