---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import ProjectCover from './ProjectCover.astro';

interface Props {
	project: CollectionEntry<'projects'>;
	headingLevel?: 'h2' | 'h3';
	/** Responsive `sizes` for the cover image; match the grid the card sits in. */
	sizes?: string;
	eager?: boolean;
}

const {
	project,
	headingLevel: Heading = 'h3',
	sizes = '(min-width: 1216px) 560px, (min-width: 640px) 50vw, 100vw',
	eager = false,
} = Astro.props;
const { title, name, summary, cover, coverFit, motif } = project.data;
---

<article class="group relative">
	<div class="bg-figure">
		{
			cover ? (
				<Image
					src={cover}
					alt=""
					widths={[480, 720, 1120]}
					sizes={sizes}
					loading={eager ? 'eager' : 'lazy'}
					class:list={['aspect-[16/10] w-full', coverFit === 'contain' ? 'object-contain p-5 sm:p-7' : 'object-cover']}
				/>
			) : (
				<ProjectCover motif={motif} class="aspect-[16/10] w-full" />
			)
		}
	</div>
	<p class="meta mt-5">{name}</p>
	<Heading class="mt-2 text-[1.5rem] leading-[1.2] sm:text-[1.625rem]">
		<a href={`/projects/${project.id}/`} class="outline-none after:absolute after:inset-0 group-hover:text-accent">
			{title}
		</a>
	</Heading>
	<p class="mt-3 leading-relaxed">{summary}</p>
</article>
