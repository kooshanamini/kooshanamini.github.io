---
/**
 * Abstract illustrations, used as a project cover when no figure is set.
 * Colors come from the theme tokens, so the art follows light and dark mode.
 */
interface Props {
	motif: 'satellite' | 'architecture' | 'flood' | 'network';
	class?: string;
}

const { motif, class: className } = Astro.props;

const labels = {
	satellite: 'Illustration: satellite image tiles with road segments classified as damaged or clear',
	architecture: 'Illustration: data sources feeding a schema-validated message bus, Bayesian fusion, and a decision',
	flood: 'Illustration: flood depth bands and a library of 99 maps reduced to 29 representative maps',
	network: 'Illustration: a power network being restored after a storm, beside a restoration curve',
};

// satellite: 6 × 4 image tiles separated by streets; a few street segments are classified
const tiles = Array.from({ length: 24 }, (_, i) => {
	const row = Math.floor(i / 6);
	const col = i % 6;
	return { x: 28 + col * 92, y: 20 + row * 92, tint: 6 + ((row * 7 + col * 11) % 5) * 3.5 };
});
const streetsH = [108, 200, 292];
const streetsV = [116, 208, 300, 392, 484];
const damagedSegments = [
	[208, 200, 300, 200],
	[484, 108, 484, 200],
	[392, 292, 484, 292],
];
const clearSegments = [
	[116, 108, 208, 108],
	[116, 200, 116, 292],
	[300, 292, 300, 400],
	[484, 200, 600, 200],
];

// architecture: four sources -> schema bus -> fusion -> decision
const sources = [52, 132, 212, 292];
const jsonLines = [36, 26, 30, 20, 34, 24, 28, 18, 36, 26, 22, 32, 24, 34, 20].map((w, i) => ({
	w,
	indent: i % 4 === 1 || i % 4 === 2,
}));

// flood: 99 scenario maps, 29 kept as representatives
const maps = Array.from({ length: 99 }, (_, i) => ({
	x: 384 + (i % 10) * 19,
	y: 64 + Math.floor(i / 10) * 19,
	kept: (i * 37) % 99 < 29,
}));

// network: a distribution network partly restored
const nodes = {
	S: [70, 200],
	A: [165, 122],
	B: [165, 278],
	A1: [255, 72],
	A2: [262, 168],
	B1: [258, 236],
	B2: [250, 332],
	a1: [345, 48],
	a2: [340, 106],
	a3: [352, 186],
	b1: [348, 232],
	b2: [356, 290],
	b3: [342, 352],
} as const;
type NodeId = keyof typeof nodes;
const restored = new Set<NodeId>(['S', 'A', 'B', 'A1', 'A2', 'a1', 'a2']);
const damagedNodes = new Set<NodeId>(['B1', 'b1', 'b2']);
const edges: [NodeId, NodeId][] = [
	['S', 'A'],
	['S', 'B'],
	['A', 'A1'],
	['A', 'A2'],
	['B', 'B1'],
	['B', 'B2'],
	['A1', 'a1'],
	['A1', 'a2'],
	['A2', 'a3'],
	['B1', 'b1'],
	['B1', 'b2'],
	['B2', 'b3'],
];
const nodeClass = (id: NodeId) => (restored.has(id) ? 'm-node-on' : damagedNodes.has(id) ? 'm-node-warn' : 'm-node-off');
const steps = 'H460 V232 H482 V208 H502 V184 H524 V160 H546 V146 H556';
---

<div class:list={['relative isolate overflow-hidden bg-surface', className]}>
	<div aria-hidden="true" class="dot-grid absolute inset-0 -z-10 opacity-70 [mask-image:none]"></div>
	<svg viewBox="0 0 600 400" preserveAspectRatio="xMidYMid slice" role="img" aria-label={labels[motif]} class="size-full">
		{
			motif === 'satellite' && (
				<g>
					{tiles.map((t) => (
						<rect
							x={t.x}
							y={t.y}
							width="84"
							height="84"
							rx="6"
							style={`fill: color-mix(in srgb, var(--accent) ${t.tint}%, var(--surface))`}
						/>
					))}
					{streetsH.map((y) => (
						<line x1="0" x2="600" y1={y} y2={y} class="m-street" />
					))}
					{streetsV.map((x) => (
						<line x1={x} x2={x} y1="0" y2="400" class="m-street" />
					))}
					{damagedSegments.map((s) => (
						<line x1={s[0]} y1={s[1]} x2={s[2]} y2={s[3]} class="m-seg m-seg-warn" />
					))}
					{clearSegments.map((s) => (
						<line x1={s[0]} y1={s[1]} x2={s[2]} y2={s[3]} class="m-seg m-seg-ok" />
					))}
					{damagedSegments.map((s) => (
						<circle cx={(s[0] + s[2]) / 2} cy={(s[1] + s[3]) / 2} r="7" class="m-marker-warn" />
					))}
					{clearSegments.slice(0, 3).map((s) => (
						<circle cx={(s[0] + s[2]) / 2} cy={(s[1] + s[3]) / 2} r="7" class="m-marker-ok" />
					))}
					<path d="M299 128 V107 H320 M372 107 H393 V128 M393 180 V201 H372 M320 201 H299 V180" class="m-bracket" />
				</g>
			)
		}
		{
			motif === 'architecture' && (
				<g>
					{sources.map((y, i) => (
						<g>
							<rect x="76" y={y} width="132" height="48" rx="12" class="m-node" />
							{i === 0 && <circle cx="98" cy={y + 24} r="9" class="m-glyph-fill" />}
							{i === 1 && (
								<g>
									<rect x="89" y={y + 15} width="18" height="18" rx="4" class="m-glyph-stroke" />
									<circle cx="98" cy={y + 24} r="4" class="m-glyph-stroke" />
								</g>
							)}
							{i === 2 && <path d={`M86 ${y + 27} q6 -10 12 0 t12 0`} class="m-glyph-stroke" />}
							{i === 3 && (
								<g class="m-glyph-fill">
									<rect x="88" y={y + 28} width="5" height="8" rx="1.5" />
									<rect x="95.5" y={y + 22} width="5" height="14" rx="1.5" />
									<rect x="103" y={y + 16} width="5" height="20" rx="1.5" />
								</g>
							)}
							<rect x="126" y={y + 16} width="60" height="6" rx="3" class="m-bar" />
							<rect x="126" y={y + 27} width="38" height="6" rx="3" class="m-bar-soft" />
							<line x1="208" y1={y + 24} x2="264" y2={y + 24} class="m-wire" />
							<path d={`M258 ${y + 19} L265 ${y + 24} L258 ${y + 29}`} class="m-wire" />
						</g>
					))}
					<rect x="268" y="40" width="64" height="320" rx="16" class="m-bus" />
					{jsonLines.map((line, i) => (
						<rect x={line.indent ? 290 : 282} y={58 + i * 19} width={line.w} height="5" rx="2.5" class="m-json" />
					))}
					<line x1="332" y1="140" x2="420" y2="140" class="m-wire-accent" />
					<path d="M414 135 L421 140 L414 145" class="m-wire-accent" />
					<circle cx="470" cy="140" r="46" class="m-ring" />
					<circle cx="470" cy="140" r="30" class="m-fill-1" />
					<circle cx="470" cy="140" r="15" class="m-fill-2" />
					<circle cx="470" cy="140" r="5" class="m-fill-3" />
					<line x1="470" y1="186" x2="470" y2="243" class="m-wire-accent" />
					<path d="M465 238 L470 245 L475 238" class="m-wire-accent" />
					<line x1="332" y1="277" x2="406" y2="277" class="m-wire-dash" />
					<rect x="410" y="248" width="120" height="58" rx="14" class="m-out" />
					<rect x="428" y="266" width="64" height="6" rx="3" class="m-out-bar" />
					<rect x="428" y="280" width="42" height="6" rx="3" class="m-out-bar" />
				</g>
			)
		}
		{
			motif === 'flood' && (
				<g>
					<path d="M0 128 C 130 104 240 158 350 128 S 530 84 600 102" class="m-contour" style="opacity: 0.16" />
					<path d="M0 176 C 120 150 220 210 340 176 S 520 126 600 146" class="m-contour" />
					<path d="M0 232 C 110 200 210 268 330 228 S 520 168 600 192 V400 H0 Z" class="m-water" style="opacity: 0.1" />
					<path d="M0 286 C 130 252 240 318 360 282 S 530 236 600 252 V400 H0 Z" class="m-water" style="opacity: 0.16" />
					<path d="M0 338 C 150 312 260 364 390 334 S 540 300 600 314 V400 H0 Z" class="m-water" style="opacity: 0.26" />
					<path d="M70 400 L170 250 L300 168 L600 120" class="m-road" />
					<path d="M70 400 L162 262" class="m-road-closed" />
					<rect x="372" y="46" width="209" height="215" rx="14" class="m-node" />
					{maps.map((m) => (
						<rect x={m.x} y={m.y} width="14" height="14" rx="3" class={m.kept ? 'm-kept' : 'm-dropped'} />
					))}
				</g>
			)
		}
		{
			motif === 'network' && (
				<g>
					<line x1={nodes.A2[0]} y1={nodes.A2[1]} x2={nodes.B1[0]} y2={nodes.B1[1]} class="m-tie" />
					{edges.map(([from, to]) => (
						<line
							x1={nodes[from][0]}
							y1={nodes[from][1]}
							x2={nodes[to][0]}
							y2={nodes[to][1]}
							class={restored.has(from) && restored.has(to) ? 'm-edge-on' : 'm-edge'}
						/>
					))}
					{(Object.keys(nodes) as NodeId[])
						.filter((id) => id !== 'S')
						.map((id) => (
							<circle
								cx={nodes[id][0]}
								cy={nodes[id][1]}
								r={id === id.toLowerCase() ? 7 : 9}
								class={nodeClass(id)}
							/>
						))}
					<rect x="59" y="189" width="22" height="22" rx="5" class="m-node-on" />
					<rect x="414" y="100" width="162" height="200" rx="14" class="m-node" />
					<line x1="436" x2="556" y1="162" y2="162" class="m-grid" />
					<line x1="436" x2="556" y1="200" y2="200" class="m-grid" />
					<line x1="436" x2="556" y1="238" y2="238" class="m-grid" />
					<path d={`M436 276 V258 ${steps} V276 Z`} class="m-area" />
					<path d={`M436 258 ${steps}`} class="m-curve" />
					<path d="M436 124 V276 H556" class="m-axis" />
				</g>
			)
		}
	</svg>
</div>

<style>
	.m-street {
		stroke: var(--line-strong);
		stroke-width: 2;
	}
	.m-seg {
		stroke-width: 6;
		stroke-linecap: round;
	}
	.m-seg-warn {
		stroke: var(--warn);
	}
	.m-seg-ok {
		stroke: var(--accent);
	}
	.m-marker-warn,
	.m-marker-ok {
		fill: var(--bg);
		stroke-width: 3;
	}
	.m-marker-warn {
		stroke: var(--warn);
	}
	.m-marker-ok {
		stroke: var(--accent);
	}
	.m-bracket {
		fill: none;
		stroke: var(--accent);
		stroke-width: 3.5;
		stroke-linecap: round;
		stroke-linejoin: round;
	}
	.m-node {
		fill: var(--bg);
		stroke: var(--line-strong);
		stroke-width: 1.5;
	}
	.m-bar {
		fill: var(--line-strong);
	}
	.m-bar-soft {
		fill: var(--line);
	}
	.m-glyph-fill {
		fill: var(--accent);
		opacity: 0.85;
	}
	.m-glyph-stroke {
		fill: none;
		stroke: var(--accent);
		stroke-width: 2;
		stroke-linecap: round;
	}
	.m-wire {
		fill: none;
		stroke: var(--line-strong);
		stroke-width: 1.75;
		stroke-linecap: round;
		stroke-linejoin: round;
	}
	.m-wire-accent {
		fill: none;
		stroke: var(--accent);
		stroke-width: 2;
		stroke-linecap: round;
		stroke-linejoin: round;
	}
	.m-wire-dash {
		stroke: var(--accent);
		stroke-width: 1.75;
		stroke-dasharray: 4 6;
		opacity: 0.7;
	}
	.m-bus {
		fill: var(--accent-soft);
		stroke: color-mix(in srgb, var(--accent) 45%, transparent);
		stroke-width: 1.5;
	}
	.m-json {
		fill: var(--accent);
		opacity: 0.5;
	}
	.m-ring {
		fill: var(--bg);
		stroke: var(--accent);
		stroke-width: 2;
	}
	.m-fill-1 {
		fill: var(--accent);
		opacity: 0.12;
	}
	.m-fill-2 {
		fill: var(--accent);
		opacity: 0.45;
	}
	.m-fill-3,
	.m-out,
	.m-kept,
	.m-node-on {
		fill: var(--accent);
	}
	.m-out-bar {
		fill: var(--accent-fg);
		opacity: 0.85;
	}
	.m-contour {
		fill: none;
		stroke: var(--accent);
		stroke-width: 1.5;
		opacity: 0.3;
	}
	.m-water {
		fill: var(--accent);
	}
	.m-road {
		fill: none;
		stroke: var(--fg);
		stroke-width: 6;
		stroke-linecap: round;
		stroke-linejoin: round;
		opacity: 0.2;
	}
	.m-road-closed {
		fill: none;
		stroke: var(--warn);
		stroke-width: 6;
		stroke-linecap: round;
		stroke-dasharray: 10 9;
	}
	.m-dropped {
		fill: none;
		stroke: var(--line-strong);
		stroke-width: 1.25;
	}
	.m-edge {
		stroke: var(--line-strong);
		stroke-width: 2.25;
	}
	.m-edge-on {
		stroke: var(--accent);
		stroke-width: 2.5;
		opacity: 0.65;
	}
	.m-tie {
		stroke: var(--line-strong);
		stroke-width: 2;
		stroke-dasharray: 3 5;
	}
	.m-node-warn {
		fill: var(--bg);
		stroke: var(--warn);
		stroke-width: 3;
	}
	.m-node-off {
		fill: var(--line-strong);
	}
	.m-axis {
		fill: none;
		stroke: var(--line-strong);
		stroke-width: 1.5;
	}
	.m-grid {
		stroke: var(--line);
		stroke-width: 1.25;
		stroke-dasharray: 3 5;
	}
	.m-curve {
		fill: none;
		stroke: var(--accent);
		stroke-width: 3;
		stroke-linejoin: round;
	}
	.m-area {
		fill: var(--accent);
		opacity: 0.12;
	}
</style>
