---
import Icon from './Icon.astro';

interface Props {
	count: number;
}

const { count } = Astro.props;
---

<span
	class="inline-flex items-center gap-1.5 rounded-md bg-accent-soft px-2.5 py-1 text-xs font-semibold text-accent tabular-nums"
	title="Citation count from Google Scholar"
>
	<Icon name="quote" class="size-3.5" />
	Cited by {count}
</span>
