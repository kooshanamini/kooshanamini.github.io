---
interface Props {
	eyebrow?: string;
	title: string;
	description?: string;
	id?: string;
}

const { eyebrow, title, description, id } = Astro.props;
---

<div class="max-w-2xl">
	{eyebrow && <p class="eyebrow">{eyebrow}</p>}
	<h2 id={id} class="mt-2 text-2xl font-semibold tracking-tight text-fg sm:text-[1.75rem] sm:leading-tight">
		{title}
	</h2>
	{description && <p class="mt-3 text-base leading-relaxed text-muted">{description}</p>}
</div>
