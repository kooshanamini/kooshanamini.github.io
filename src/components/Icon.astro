type IconName = keyof typeof strokeIcons | keyof typeof brandIcons;

interface Props {
	name: IconName;
	class?: string;
	/** Accessible name. Without it the icon is decorative and hidden from assistive tech. */
	title?: string;
	[attribute: string]: unknown;
}

const { name, class: className, title, ...rest } = Astro.props;
const isBrand = name in brandIcons;
const body = isBrand ? brandIcons[name as keyof typeof brandIcons] : strokeIcons[name as keyof typeof strokeIcons];
---

<svg
	xmlns="http://www.w3.org/2000/svg"
	viewBox="0 0 24 24"
	fill={isBrand ? 'currentColor' : 'none'}
	stroke={isBrand ? undefined : 'currentColor'}
	stroke-width={isBrand ? undefined : 1.75}
	stroke-linecap={isBrand ? undefined : 'round'}
	stroke-linejoin={isBrand ? undefined : 'round'}
	class:list={['shrink-0', className ?? 'size-4']}
	role={title ? 'img' : undefined}
	aria-hidden={title ? undefined : 'true'}
	{...rest}
>
	{title && <title>{title}</title>}
	<Fragment set:html={body} />
</svg>
