---
import type { LinkKind } from '../data/publications';

interface Props {
	href: string;
	label: string;
	kind?: LinkKind | 'project';
}

const { href, label } = Astro.props;
---

<a
	href={href}
	class="text-[0.9375rem] font-medium text-fg underline decoration-line-strong decoration-1 underline-offset-[5px] transition-colors hover:text-accent hover:decoration-accent"
>
	{label}
</a>
