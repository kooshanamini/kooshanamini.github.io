---
import Icon from './Icon.astro';
---

<button
	type="button"
	class="grid size-10 place-items-center text-fg transition-colors hover:text-accent"
	aria-label="Dark mode"
	aria-pressed="false"
	title="Toggle dark mode"
	data-theme-toggle
>
	<Icon name="moon" class="size-[18px] dark:hidden" />
	<Icon name="sun" class="hidden size-[18px] dark:block" />
</button>

<script>
	for (const button of document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]')) {
		const sync = () => button.setAttribute('aria-pressed', String(document.documentElement.classList.contains('dark')));
		sync();
		button.addEventListener('click', () => {
			const dark = document.documentElement.classList.toggle('dark');
			document.querySelector('meta[name="theme-color"]')?.setAttribute('content', dark ? '#0e1820' : '#eef3f5');
			try {
				localStorage.setItem('theme', dark ? 'dark' : 'light');
			} catch {
				// Storage unavailable (private mode, blocked site data): the choice lasts for this page view.
			}
			sync();
		});
	}
</script>
