---
import CitationBadge from '../components/CitationBadge.astro';
import Icon from '../components/Icon.astro';
import LinkPill from '../components/LinkPill.astro';
import PageHeader from '../components/PageHeader.astro';
import PublicationItem from '../components/PublicationItem.astro';
import { artifacts, publications, type Publication } from '../data/publications';
import { site } from '../data/site';
import BaseLayout from '../layouts/BaseLayout.astro';
import { citationsFor, scholar } from '../data/citations';
import { formatDate } from '../lib/format';

const groups: { id: string; title: string; items: Publication[] }[] = [
	{ id: 'journal', title: 'Journal articles', items: publications.filter((pub) => pub.type === 'journal') },
	{ id: 'preprints', title: 'Preprints', items: publications.filter((pub) => pub.type === 'preprint') },
	{ id: 'conference', title: 'Conference papers', items: publications.filter((pub) => pub.type === 'conference') },
];
const scholarProfile = site.social.find((item) => item.icon === 'scholar');
---

<BaseLayout
	title="Publications"
	description="Publications by Kooshan Amini: journal articles, preprints, conference papers, datasets, and open-source code in computer vision, remote sensing, and probabilistic risk modeling."
>
	<PageHeader
		title="Publications"
		lead="Five peer-reviewed journal articles (four as first author), a preprint under review, conference papers, and the datasets and code behind them."
	>
		<div class="mt-8 flex flex-wrap items-center gap-3">
			<span class="inline-flex h-[2.875rem] items-center gap-2 text-[1.0625rem] tabular-nums">
				<Icon name="quote" />
				{scholar.total.toLocaleString('en-US')} citations, h-index {scholar.hIndex}
			</span>
			{
				scholarProfile && (
					<a href={scholarProfile.href} class="btn btn-secondary">
						<Icon name="scholar" />
						Google Scholar profile
					</a>
				)
			}
		</div>
	</PageHeader>

	<div class="container-site space-y-20 pb-24">
		{
			groups.map((group) => (
				<section aria-labelledby={group.id}>
					<h2 id={group.id} class="flex items-baseline gap-4 text-[2rem] leading-tight">
						{group.title}
						<span class="font-sans text-base font-normal tracking-normal text-muted tabular-nums">{group.items.length}</span>
					</h2>
					<ol class="mt-6 divide-y divide-line border-y border-line">
						{group.items.map((pub) => (
							<li class="grid gap-2 py-6 sm:grid-cols-[4.5rem_minmax(0,1fr)] sm:gap-6">
								<p class="meta tabular-nums">{pub.year}</p>
								<PublicationItem pub={pub} citations={citationsFor(pub.id)} />
							</li>
						))}
					</ol>
				</section>
			))
		}

		<section aria-labelledby="artifacts">
			<h2 id="artifacts" class="flex items-baseline gap-4 text-[2rem] leading-tight">
				Datasets & software
				<span class="font-sans text-base font-normal tracking-normal text-muted tabular-nums">{artifacts.length}</span>
			</h2>
			<ol class="mt-6 divide-y divide-line border-y border-line">
				{
					artifacts.map((item) => (
						<li class="grid gap-2 py-6 sm:grid-cols-[4.5rem_minmax(0,1fr)] sm:gap-6">
							{item.year ? (
								<p class="meta tabular-nums">{item.year}</p>
							) : (
								<span class="hidden sm:block" />
							)}
							<div>
								<p class="meta">{item.kind}</p>
								<h3 class="mt-1.5 text-[1.25rem] leading-[1.3]">{item.title}</h3>
								<p class="mt-1 text-[0.9375rem] text-muted">
									{item.host}
									{item.note && <span>. {item.note}</span>}
								</p>
								{(item.links || (item.id && citationsFor(item.id))) && (
									<div class="mt-3 flex flex-wrap items-center gap-x-5 gap-y-2">
										{item.links?.map((link) => (
											<LinkPill {...link} />
										))}
										{item.id && citationsFor(item.id) && <CitationBadge count={citationsFor(item.id) ?? 0} />}
									</div>
								)}
							</div>
						</li>
					))
				}
			</ol>
		</section>

		<p class="meta">
			Citation counts are from <a href={scholar.href} class="link">Google Scholar</a>, last updated {formatDate(scholar.asOf)}.
		</p>
	</div>
</BaseLayout>
