---
import Icon from '../components/Icon.astro';
import LinkPill from '../components/LinkPill.astro';
import PageHeader from '../components/PageHeader.astro';
import PublicationItem from '../components/PublicationItem.astro';
import { artifacts, publications, type Publication } from '../data/publications';
import { site } from '../data/site';
import BaseLayout from '../layouts/BaseLayout.astro';
import { citationsFor, getCitationCounts, totalCitations } from '../lib/openalex';

const counts = await getCitationCounts();
const total = totalCitations(counts);
const groups: { id: string; title: string; items: Publication[] }[] = [
	{ id: 'journal', title: 'Journal articles', items: publications.filter((pub) => pub.type === 'journal') },
	{ id: 'preprints', title: 'Preprints', items: publications.filter((pub) => pub.type === 'preprint') },
	{ id: 'conference', title: 'Conference papers', items: publications.filter((pub) => pub.type === 'conference') },
];
const scholar = site.social.find((item) => item.icon === 'scholar');
---

<BaseLayout
	title="Publications"
	description="Publications by Kooshan Amini: journal articles, preprints, conference papers, datasets, and open-source code in computer vision, remote sensing, and probabilistic risk modeling."
>
	<PageHeader
		eyebrow="Research"
		title="Publications"
		lead="Five peer-reviewed journal articles (four as first author), a preprint under review, conference papers, and the datasets and code behind them."
	>
		<div class="mt-8 flex flex-wrap items-center gap-3">
			{
				total > 0 && (
					<span class="inline-flex h-10 items-center gap-2 rounded-[0.625rem] bg-accent-soft px-4 text-sm font-semibold text-accent tabular-nums">
						<Icon name="quote" />
						{total.toLocaleString('en-US')} citations
					</span>
				)
			}
			{
				scholar && (
					<a href={scholar.href} class="btn btn-secondary">
						<Icon name="scholar" />
						Google Scholar profile
					</a>
				)
			}
		</div>
	</PageHeader>

	<div class="container-site space-y-16">
		{
			groups.map((group) => (
				<section aria-labelledby={group.id}>
					<h2 id={group.id} class="flex items-baseline gap-3 text-xl font-semibold tracking-tight text-fg">
						{group.title}
						<span class="text-sm font-normal text-subtle tabular-nums">{group.items.length}</span>
					</h2>
					<ol class="mt-4 divide-y divide-line border-y border-line">
						{group.items.map((pub) => (
							<li class="grid gap-2 py-6 sm:grid-cols-[4.5rem_minmax(0,1fr)] sm:gap-6">
								<p class="text-sm font-medium text-subtle tabular-nums">{pub.year}</p>
								<PublicationItem pub={pub} citations={citationsFor(counts, pub.doi)} />
							</li>
						))}
					</ol>
				</section>
			))
		}

		<section aria-labelledby="artifacts">
			<h2 id="artifacts" class="flex items-baseline gap-3 text-xl font-semibold tracking-tight text-fg">
				Datasets & software
				<span class="text-sm font-normal text-subtle tabular-nums">{artifacts.length}</span>
			</h2>
			<ol class="mt-4 divide-y divide-line border-y border-line">
				{
					artifacts.map((item) => (
						<li class="grid gap-2 py-6 sm:grid-cols-[4.5rem_minmax(0,1fr)] sm:gap-6">
							{item.year ? (
								<p class="text-sm font-medium text-subtle tabular-nums">{item.year}</p>
							) : (
								<span class="hidden sm:block" />
							)}
							<div>
								<p class="text-xs font-semibold uppercase tracking-wider text-accent">{item.kind}</p>
								<h3 class="mt-1.5 text-[1.0625rem] font-semibold leading-snug text-fg">{item.title}</h3>
								<p class="mt-1 text-sm text-muted">
									{item.host}
									{item.note && <span class="text-subtle"> · {item.note}</span>}
								</p>
								{item.links && (
									<div class="mt-3 flex flex-wrap gap-2">
										{item.links.map((link) => (
											<LinkPill {...link} />
										))}
									</div>
								)}
							</div>
						</li>
					))
				}
			</ol>
		</section>

		<p class="text-sm text-subtle">
			Citation counts come from <a href="https://openalex.org" class="link">OpenAlex</a> and refresh weekly, so they can
			differ slightly from Google Scholar.
		</p>
	</div>
</BaseLayout>
