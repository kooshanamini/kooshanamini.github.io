---
import PageHeader from '../components/PageHeader.astro';
import { conferenceTalks, invitedTalks, workshops, type Talk } from '../data/talks';
import BaseLayout from '../layouts/BaseLayout.astro';
import { formatDate, formatMonth } from '../lib/format';

const sections: { id: string; title: string; items: Talk[] }[] = [
	{ id: 'invited', title: 'Invited talks', items: invitedTalks },
	{ id: 'workshops', title: 'Workshops & training', items: workshops },
	{ id: 'conference', title: 'Conference talks', items: conferenceTalks },
];

/** Full date when the day is known ("Sep 17, 2026"), otherwise month and year ("Feb 2024"). */
const when = (iso: string) => (iso.length > 7 ? formatDate(iso) : formatMonth(iso));
---

<BaseLayout
	title="Talks"
	description="Invited talks, webinars, workshops, and conference presentations by Kooshan Amini on AI for disaster imagery, hurricane debris risk, and community resilience modeling."
>
	<PageHeader
		title="Talks & presentations"
		lead="Invited webinars and a roundtable, hands-on workshops, and conference talks since 2023 on AI for disaster imagery, hurricane debris risk, and community resilience modeling."
	/>

	<div class="container-site space-y-20 pb-24">
		{
			sections.map((section) => (
				<section aria-labelledby={section.id}>
					<h2 id={section.id} class="flex items-baseline gap-4 text-[2rem] leading-tight">
						{section.title}
						<span class="font-sans text-base font-normal tracking-normal text-muted tabular-nums">{section.items.length}</span>
					</h2>
					<ol class="mt-6 divide-y divide-line border-y border-line">
						{section.items.map((talk) => (
							<li class="grid gap-2 py-6 sm:grid-cols-[8.5rem_minmax(0,1fr)] sm:gap-6">
								<p class="meta tabular-nums">
									<time datetime={talk.date}>{when(talk.date)}</time>
								</p>
								<div>
									<p class="meta">{talk.kind}</p>
									<h3 class="mt-1.5 text-[1.25rem] leading-[1.3]">
										{talk.href ? (
											<a href={talk.href} class="transition-colors hover:text-accent">
												{talk.title}
											</a>
										) : (
											talk.title
										)}
									</h3>
									<p class="mt-1 text-[0.9375rem] leading-relaxed text-muted">
										{talk.event}
										{talk.host && <span>, {talk.host}</span>}
									</p>
									{talk.note && <p class="mt-1 text-[0.9375rem] text-muted">{talk.note}</p>}
								</div>
							</li>
						))}
					</ol>
				</section>
			))
		}
	</div>
</BaseLayout>
