---
import { getCollection } from 'astro:content';
import PageHeader from '../../components/PageHeader.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout
	title="Projects"
	description="Projects by Kooshan Amini in computer vision, vision-language models, ML systems, and probabilistic risk modeling, with the problem, approach, results, and role for each."
>
	<PageHeader
		eyebrow="Projects"
		title="Selected projects"
		lead="Computer vision, vision-language models, ML systems, and probabilistic modeling, from peer-reviewed research to production pipelines. Each write-up covers the problem, the approach, the results, and my role."
	/>
	<section class="container-site">
		<h2 class="sr-only">All projects</h2>
		<div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
			{
				projects.map((project, i) => (
					<ProjectCard
						project={project}
						eager={i < 3}
						sizes="(min-width: 1152px) 352px, (min-width: 1024px) 31vw, (min-width: 640px) 50vw, 100vw"
					/>
				))
			}
		</div>
	</section>
</BaseLayout>
