---
import { getImage, Image } from 'astro:assets';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Icon from '../../components/Icon.astro';
import Lightbox from '../../components/Lightbox.astro';
import LinkPill from '../../components/LinkPill.astro';
import ProjectCover from '../../components/ProjectCover.astro';
import PublicationItem from '../../components/PublicationItem.astro';
import { publications } from '../../data/publications';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { citationsFor } from '../../data/citations';

export async function getStaticPaths() {
	const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
	return projects.map((project, i) => ({
		params: { slug: project.id },
		props: { project, prev: projects[i - 1], next: projects[i + 1] },
	}));
}

interface Props {
	project: CollectionEntry<'projects'>;
	prev?: CollectionEntry<'projects'>;
	next?: CollectionEntry<'projects'>;
}

const { project, prev, next } = Astro.props;
const { Content } = await render(project);
const data = project.data;
const publication = data.publication ? publications.find((pub) => pub.id === data.publication) : undefined;
const ogImage = data.cover ? (await getImage({ src: data.cover, width: 1200, format: 'jpg' })).src : undefined;

const meta = [
	{ label: 'Role', value: data.role },
	{ label: 'Context', value: data.context },
	...(data.period ? [{ label: 'Timeline', value: data.period }] : []),
];
---

<BaseLayout title={data.title} description={data.summary} type="article" image={ogImage}>
	<article>
		<header class="relative isolate">
			<div aria-hidden="true" class="dot-grid pointer-events-none absolute inset-0 -z-10"></div>
			<div class="container-site pt-10 sm:pt-12">
				<a href="/projects/" class="inline-flex items-center gap-1.5 text-sm font-medium text-muted transition-colors hover:text-fg">
					<Icon name="arrow-left" class="size-4" />
					All projects
				</a>
				<div class="mt-8 grid items-center gap-10 lg:grid-cols-[minmax(0,1fr)_minmax(0,1fr)] lg:gap-14">
					<div>
						<p class="eyebrow">{data.name}</p>
						<h1 class="mt-3 text-3xl font-semibold tracking-tight text-fg sm:text-4xl sm:leading-tight">{data.title}</h1>
						<p class="mt-5 text-lg leading-relaxed text-muted">{data.summary}</p>
						{
							data.links.length > 0 && (
								<div class="mt-7 flex flex-wrap gap-2">
									{data.links.map((link) => (
										<LinkPill {...link} />
									))}
								</div>
							)
						}
					</div>
					<div class="overflow-hidden rounded-2xl border border-line bg-surface shadow-[0_24px_56px_-32px_rgb(14_22_38/0.35)]">
						{
							data.cover ? (
								<Image
									src={data.cover}
									alt={data.coverAlt}
									widths={[560, 840, 1120]}
									sizes="(min-width: 1152px) 528px, (min-width: 1024px) 46vw, 100vw"
									loading="eager"
									data-zoomable
									class:list={[
										'aspect-[2/1] w-full',
										data.coverFit === 'contain' ? 'bg-figure object-contain p-5' : 'object-cover',
									]}
								/>
							) : (
								<ProjectCover motif={data.motif} class="aspect-[2/1] w-full" />
							)
						}
					</div>
				</div>

				<dl class="mt-12 grid gap-x-10 gap-y-5 border-y border-line py-6 sm:grid-cols-3">
					{
						meta.map((item) => (
							<div>
								<dt class="text-xs font-semibold uppercase tracking-wider text-subtle">{item.label}</dt>
								<dd class="mt-1.5 text-sm leading-relaxed text-fg">{item.value}</dd>
							</div>
						))
					}
				</dl>
			</div>
		</header>

		{
			data.metrics.length > 0 && (
				<section aria-label="Key results" class="container-site mt-8">
					<dl class="grid gap-4 sm:grid-cols-3">
						{data.metrics.map((metric) => (
							<div class="flex flex-col-reverse gap-1.5 rounded-2xl border border-line bg-surface p-5 sm:p-6">
								<dt class="text-sm leading-snug text-muted">{metric.label}</dt>
								<dd class="text-2xl font-semibold tracking-tight text-accent tabular-nums sm:text-[1.75rem]">
									{metric.value}
								</dd>
							</div>
						))}
					</dl>
				</section>
			)
		}

		<div class="container-site mt-14">
			<div class="prose prose-site mx-auto">
				<Content />
			</div>

			<div class="mx-auto mt-14 max-w-[46rem] space-y-10">
				{
					data.stack.length > 0 && (
						<section aria-labelledby="stack">
							<h2 id="stack" class="text-xs font-semibold uppercase tracking-wider text-subtle">
								Stack
							</h2>
							<ul class="mt-3 flex flex-wrap gap-2">
								{data.stack.map((item) => (
									<li class="chip">{item}</li>
								))}
							</ul>
						</section>
					)
				}
				{
					publication && (
						<section aria-labelledby="publication">
							<h2 id="publication" class="text-xs font-semibold uppercase tracking-wider text-subtle">
								Publication
							</h2>
							<div class="mt-3 rounded-2xl border border-line bg-surface p-5 sm:p-6">
								<PublicationItem
									pub={{ ...publication, project: undefined }}
									citations={citationsFor(publication.id)}
								/>
							</div>
						</section>
					)
				}
			</div>
		</div>

		<nav aria-label="More projects" class="container-site mt-16">
			<div class="grid gap-4 border-t border-line pt-8 sm:grid-cols-2">
				{
					prev ? (
						<a href={`/projects/${prev.id}/`} class="group rounded-2xl border border-line p-5 transition-colors hover:border-line-strong hover:bg-surface">
							<span class="inline-flex items-center gap-1.5 text-xs font-medium text-subtle">
								<Icon name="arrow-left" class="size-3.5" />
								Previous
							</span>
							<span class="mt-2 block font-semibold leading-snug text-fg group-hover:text-accent">{prev.data.title}</span>
						</a>
					) : (
						<span class="hidden sm:block" />
					)
				}
				{
					next && (
						<a href={`/projects/${next.id}/`} class="group rounded-2xl border border-line p-5 text-right transition-colors hover:border-line-strong hover:bg-surface">
							<span class="inline-flex items-center gap-1.5 text-xs font-medium text-subtle">
								Next
								<Icon name="arrow-right" class="size-3.5" />
							</span>
							<span class="mt-2 block font-semibold leading-snug text-fg group-hover:text-accent">{next.data.title}</span>
						</a>
					)
				}
			</div>
		</nav>
		<Lightbox />
	</article>
</BaseLayout>
