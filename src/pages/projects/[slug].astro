---
import { getImage, Image } from 'astro:assets';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Lightbox from '../../components/Lightbox.astro';
import LinkPill from '../../components/LinkPill.astro';
import ProjectCover from '../../components/ProjectCover.astro';
import PublicationItem from '../../components/PublicationItem.astro';
import { citationsFor } from '../../data/citations';
import { publications } from '../../data/publications';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
	const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
	return projects.map((project, i) => ({
		params: { slug: project.id },
		props: { project, prev: projects[i - 1], next: projects[i + 1] },
	}));
}

interface Props {
	project: CollectionEntry<'projects'>;
	prev?: CollectionEntry<'projects'>;
	next?: CollectionEntry<'projects'>;
}

const { project, prev, next } = Astro.props;
const { Content } = await render(project);
const data = project.data;
const publication = data.publication ? publications.find((pub) => pub.id === data.publication) : undefined;
const ogImage = data.cover ? (await getImage({ src: data.cover, width: 1200, format: 'jpg' })).src : undefined;

const meta = [
	{ label: 'Role', value: data.role },
	{ label: 'Context', value: data.context },
	...(data.period ? [{ label: 'Timeline', value: data.period }] : []),
];
---

<BaseLayout title={data.title} description={data.summary} type="article" image={ogImage}>
	<article class="pb-24">
		<header class="container-site pt-14 sm:pt-20">
			<a href="/projects/" class="meta hover:text-fg">All projects</a>
			<p class="meta mt-10">{data.name}</p>
			<h1 class="mt-4 max-w-4xl text-[clamp(2.375rem,5.5vw,4rem)] font-normal leading-[1.04] tracking-[-0.025em]">
				{data.title}
			</h1>
			<p class="mt-7 max-w-[44rem] text-[1.25rem] leading-[1.55]">{data.summary}</p>
			{
				data.links.length > 0 && (
					<div class="mt-8 flex flex-wrap gap-x-6 gap-y-2">
						{data.links.map((link) => (
							<LinkPill {...link} />
						))}
					</div>
				)
			}
		</header>

		<div class="container-site mt-14">
			<div class="bg-figure">
				{
					data.cover ? (
						<Image
							src={data.cover}
							alt={data.coverAlt}
							widths={[800, 1200, 1800]}
							sizes="(min-width: 1216px) 1152px, 100vw"
							loading="eager"
							data-zoomable
							class:list={['w-full', data.coverFit === 'contain' ? 'h-auto p-5 sm:p-10' : 'aspect-[2/1] object-cover']}
						/>
					) : (
						<ProjectCover motif={data.motif} class="aspect-[2/1] w-full" />
					)
				}
			</div>

			<dl class="mt-12 grid gap-x-12 gap-y-6 sm:grid-cols-3">
				{
					meta.map((item) => (
						<div>
							<dt class="meta">{item.label}</dt>
							<dd class="mt-1.5 leading-relaxed">{item.value}</dd>
						</div>
					))
				}
			</dl>

			{
				data.metrics.length > 0 && (
					<dl class="mt-14 grid gap-x-12 gap-y-10 border-t border-line pt-12 sm:grid-cols-3" aria-label="Key results">
						{data.metrics.map((metric) => (
							<div class="flex flex-col-reverse justify-end gap-3">
								<dt class="meta max-w-[18rem]">{metric.label}</dt>
								<dd class="font-display text-[2.5rem] leading-none tracking-[-0.02em] tabular-nums">{metric.value}</dd>
							</div>
						))}
					</dl>
				)
			}
		</div>

		<div class="container-site mt-20">
			<div class="prose prose-site mx-auto">
				<Content />
			</div>

			<div class="mx-auto mt-16 max-w-[44rem] space-y-12">
				{
					data.stack.length > 0 && (
						<section aria-labelledby="stack">
							<h2 id="stack" class="text-[1.5rem]">
								Tools
							</h2>
							<p class="mt-3 leading-relaxed">{data.stack.join(', ')}</p>
						</section>
					)
				}
				{
					publication && (
						<section aria-labelledby="publication">
							<h2 id="publication" class="text-[1.5rem]">
								Publication
							</h2>
							<div class="mt-4">
								<PublicationItem
									pub={{ ...publication, project: undefined }}
									citations={citationsFor(publication.id)}
								/>
							</div>
						</section>
					)
				}
			</div>
		</div>

		<nav aria-label="More projects" class="container-site mt-24">
			<div class="grid gap-10 border-t border-line pt-10 sm:grid-cols-2">
				{
					prev ? (
						<a href={`/projects/${prev.id}/`} class="group block">
							<span class="meta">Previous project</span>
							<span class="mt-2 block font-display text-[1.375rem] leading-snug group-hover:text-accent">
								{prev.data.title}
							</span>
						</a>
					) : (
						<span class="hidden sm:block" />
					)
				}
				{
					next && (
						<a href={`/projects/${next.id}/`} class="group block sm:text-right">
							<span class="meta">Next project</span>
							<span class="mt-2 block font-display text-[1.375rem] leading-snug group-hover:text-accent">
								{next.data.title}
							</span>
						</a>
					)
				}
			</div>
		</nav>
		<Lightbox />
	</article>
</BaseLayout>
